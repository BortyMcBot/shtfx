{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BortyMcBot/shtfx/schema/handbook-schema.json",
  "title": "SHTFx Household Survival Handbook Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "household_profile",
    "location",
    "threats",
    "supplies",
    "communications",
    "evacuation",
    "shelter_in_place",
    "medical",
    "skills",
    "finances",
    "community"
  ],
  "properties": {
    "household_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "age": { "type": "number" },
              "role": { "type": "string" },
              "medical_needs": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["name", "age"]
          }
        },
        "pets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "special_needs": { "type": "string" }
            },
            "required": ["type", "name"]
          }
        },
        "notes": { "type": "string" },
        "existing_prep": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["members", "pets"]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home_area": { "type": "string" },
        "region": { "type": "string" },
        "bug_out_destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "priority": { "type": "string" },
              "name": { "type": "string" },
              "location": { "type": "string" },
              "distance_miles": { "type": "number" },
              "type": { "type": "string" },
              "notes": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "regional_hazards": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["home_area", "bug_out_destinations", "regional_hazards"]
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "wildfire",
              "earthquake",
              "civil_unrest",
              "grid_failure",
              "water_supply",
              "pandemic"
            ]
          },
          "likelihood_rank": { "type": "number" },
          "impact": { "type": "string" },
          "notes": { "type": "string" }
        },
        "required": ["name", "likelihood_rank"]
      }
    },
    "supplies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kit_72hr": {
          "type": "array",
          "items": { "type": "string" }
        },
        "food_storage_days": { "type": "number" },
        "water_storage_gallons": { "type": "number" },
        "generator": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "rated_wattage": { "type": "number" },
            "fuel_runtime_hours": { "type": "number" },
            "notes": { "type": "string" }
          }
        },
        "solar": {
          "type": "object",
          "properties": {
            "capacity_watts": { "type": "number" },
            "battery_storage_wh": { "type": "number" },
            "notes": { "type": "string" }
          }
        }
      },
      "required": ["kit_72hr", "food_storage_days", "water_storage_gallons"]
    },
    "communications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "out_of_area_contact": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "location": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "rally_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comms_plan": { "type": "string" }
      },
      "required": ["out_of_area_contact", "rally_points", "comms_plan"]
    },
    "evacuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_route": { "type": "string" },
        "secondary_route": { "type": "string" },
        "vehicle_readiness": {
          "type": "object",
          "properties": {
            "primary_vehicle": { "type": "string" },
            "fuel_range_miles": { "type": "number" },
            "maintenance_status": { "type": "string" }
          }
        },
        "go_bag_contents": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["primary_route", "secondary_route", "vehicle_readiness", "go_bag_contents"]
    },
    "shelter_in_place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home_hardening": {
          "type": "array",
          "items": { "type": "string" }
        },
        "water_storage_plan": { "type": "string" },
        "power_backup": { "type": "string" },
        "strategy": { "type": "string" }
      },
      "required": ["home_hardening", "water_storage_plan", "power_backup"]
    },
    "medical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_aid_capability": { "type": "string" },
        "medications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "special_needs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "required": ["first_aid_capability", "medications", "special_needs"]
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_aid_certs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fire": { "type": "string" },
        "navigation": { "type": "string" },
        "food_production": { "type": "string" },
        "self_defense": { "type": "string" }
      },
      "required": ["first_aid_certs", "fire", "navigation", "food_production", "self_defense"]
    },
    "finances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cash_on_hand": { "type": "number" },
        "document_copies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "insurance": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["cash_on_hand", "document_copies", "insurance"]
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "neighbors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "local_resources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mutual_aid": { "type": "string" }
      },
      "required": ["neighbors", "local_resources", "mutual_aid"]
    }
  }
}
